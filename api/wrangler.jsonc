{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "civic-compass-api",
	"main": "src/index.ts",
	// wrangler 4.92.0 同梱の workerd が対応する最新日付。Wrangler更新時に見直します。
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	// API は Frontend Worker の Service Binding からのみ呼び出します。
	"workers_dev": false,
	// フロントエンド (vinext dev) は 3000 番を使うため、API は 8000 番で固定します。
	// frontend/vite.config.ts の server.proxy がこのポートへ転送します。
	"dev": {
		"port": 8000
	},
	// 議員プロファイル・セル逆引きインデックスの置き場。
	// 【1】utterances は D1、【2】プロファイルは KV という役割分担です（docs/design-constraints.md「Cloudflare のサービス割り当て」）。
	//   profile:{speaker_id}           議員プロファイル（cells の統計値。マッチ計算で全件読む）
	//   profile:evidence:{speaker_id}  evidence（表示する議員の分だけ読む）
	//   profile:party:{党名}            政党プロファイル
	//   cellidx:{frame|target|role}    セル→議員の逆引き（B のポップアップで使う）
	"kv_namespaces": [
		{
			"binding": "PROFILES",
			"id": "be85dc91a6184ca1a9fb99a1c6bba867"
		},
		// ユーザープロファイルは議員側と名前空間ごと分けています。
		// 議員側は export-kv.mjs → `wrangler kv bulk put` で一括投入するので、
		// 同居させるとバッチの事故がユーザーデータに届く範囲に入るためです。
		// こちらは【3a】answers から作り直せますが、消えると再計算が要ります。
		//   profile:user:{user_id}   ユーザープロファイル（cells / declined_cells）
		{
			"binding": "USER_PROFILES",
			"id": "1366eb063c4943bbacb4aacb40708e89"
		}
	],
	// D1 は API Worker だけにバインドし、フロントからは Service Binding 経由で利用します。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "civic-compass-db",
			"database_id": "f53498a5-86ed-4607-91dd-9461d8808477",
			"migrations_dir": "../db/migrations"
		}
	]
}
