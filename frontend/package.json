{
  "name": "civic-compass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "cf:typegen": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types --include-runtime false",
    "cf:typecheck": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types --include-runtime false --check",
    "typecheck": "npm run cf:typecheck && tsc --noEmit",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/question-block.test.mjs tests/opinion-sheet.test.mjs tests/interest.test.mjs tests/profile-trends.test.mjs"
  },
  "dependencies": {
    "@civic-compass/shared": "*",
    "lucide-react": "^1.33.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "5.20260821.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
