# npm workspaces 構成のため、無視するファイルはこのファイルにまとめています。
# パターンの先頭にスラッシュを付けていないものは、すべての階層に適用されます。

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
.next/
.vinext/
out/
dist/
/frontend/outputs/
/frontend/work/

# cloudflare / wrangler
.wrangler/

# testing
coverage/

# 国会会議録から収集した発言データ（数十MB規模）。共有は R2 経由を想定。
# scripts/kokkai/*.mjs を実行すれば再生成できる。
/data/

# misc
.DS_Store
*.pem

# claude code（個人用コンテキスト。CLAUDE.md から @ import して使う）
CLAUDE.personalize.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

# テスト実行中だけ生成される、tsx を変換した一時ファイル
frontend/app/*.compiled.mjs
frontend/tests/*.compiled.mjs
